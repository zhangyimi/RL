+class TestFullExpertScaleLoading:
+    """Full scale inputs must retain the existing expert/TP loader semantics."""
+
+    @staticmethod
+    def _minimal_layer(*, num_experts: int, tp_rank: int, tp_size: int):
+        class FakeModelOptMethod:
+            @staticmethod
+            def uses_weight_scale_2_pattern():
+                return True
+
+        layer = RoutedExperts.__new__(RoutedExperts)
+        torch.nn.Module.__init__(layer)
+        layer.global_num_experts = num_experts
+        layer.quant_config = None
+        layer.quant_method = FakeModelOptMethod()
+        layer.moe_config = SimpleNamespace(
+            tp_rank=tp_rank,
+            is_act_and_mul=True,
+            moe_parallel_config=SimpleNamespace(tp_size=tp_size),
+        )
+        layer._map_global_expert_id_to_local_expert_id = lambda expert_id: expert_id
+        return layer
+
+    def test_w13_block_scales_reuse_tp_slicing(self):
+        layer = self._minimal_layer(num_experts=2, tp_rank=1, tp_size=2)
+        param = torch.nn.Parameter(torch.zeros(2, 4, 2), requires_grad=False)
+        param.quant_method = "block"
+        loaded = torch.arange(2 * 8 * 2, dtype=torch.float32).reshape(2, 8, 2)
+
+        assert (
+            layer.weight_loader(
+                param=param,
+                loaded_weight=loaded,
+                weight_name="layer.gate_up_proj.weight_scale",
+                shard_id="full_w13_scale",
+                expert_id=-1,
+                return_success=True,
+            )
+            is True
+        )
+
+        expected = torch.cat((loaded[:, 2:4], loaded[:, 6:8]), dim=1)
+        assert torch.equal(param, expected)
+
+    def test_matching_full_scale_shape_uses_one_direct_copy(self):
+        layer = self._minimal_layer(num_experts=2, tp_rank=0, tp_size=1)
+        param = torch.nn.Parameter(torch.zeros(2, 4, 2), requires_grad=False)
+        loaded = torch.arange(2 * 4 * 2, dtype=torch.float32).reshape(2, 4, 2)
+        layer.weight_loader = lambda **_kwargs: pytest.fail(
+            "matching shapes must not enter the per-expert fallback"
+        )
+
+        assert (
+            layer._load_full_expert_scale(
+                param=param,
+                loaded_weight=loaded,
+                weight_name="layer.gate_up_proj.weight_scale",
+                full_scale_shard="full_w13_scale",
+            )
+            is True
+        )
+        assert torch.equal(param, loaded)
+
+    def test_w2_block_scales_reuse_expert_mapping(self):
+        layer = self._minimal_layer(num_experts=4, tp_rank=0, tp_size=1)
+        local_by_global = {0: -1, 1: 0, 2: -1, 3: 1}
+        layer._map_global_expert_id_to_local_expert_id = local_by_global.get
+        param = torch.nn.Parameter(torch.zeros(2, 3, 4), requires_grad=False)
+        param.quant_method = "block"
+        loaded = torch.arange(4 * 3 * 4, dtype=torch.float32).reshape(4, 3, 4)
+
+        assert (
+            layer.weight_loader(
+                param=param,
+                loaded_weight=loaded,
+                weight_name="layer.down_proj.weight_scale",
+                shard_id="full_w2_scale",
+                expert_id=-1,
+                return_success=True,
+            )
+            is True
+        )
+
+        assert torch.equal(param[0], loaded[1])
+        assert torch.equal(param[1], loaded[3])
+
+    def test_load_weights_records_one_full_scale_call(self):
+        layer = self._minimal_layer(num_experts=2, tp_rank=0, tp_size=1)
+        layer.layer_name = "model.layers.0.mlp.experts"
+        layer.moe_config.hidden_dim_unpadded = 8
+        layer.get_expert_mapping = lambda include_fused: []
+        param = torch.nn.Parameter(torch.zeros(2, 4, 2), requires_grad=False)
+        calls = []
+
+        def loader(**kwargs):
+            calls.append(kwargs)
+            return True
+
+        param.weight_loader = loader
+        layer.w13_weight_scale = param
+        loaded = torch.ones(2, 4, 2)
+
+        assert list(layer.load_weights([("gate_up_proj.weight_scale", loaded)])) == [
+            "w13_weight_scale"
+        ]
+        assert len(calls) == 1
+        assert calls[0]["shard_id"] == "full_w13_scale"
+        assert calls[0]["loaded_weight"] is loaded
