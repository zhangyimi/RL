+    def _load_full_expert_scale(
+        self,
+        param: torch.nn.Parameter,
+        loaded_weight: torch.Tensor,
+        weight_name: str,
+        full_scale_shard: str,
+    ) -> bool:
+        """Load one scale tensor covering all logical experts.
+
+        The outer parameter loader is invoked once, so layerwise reload records
+        one complete destination instead of one record per expert/projection.
+        The existing per-expert loader remains the source of truth for TP/EP
+        routing, padding, and scale semantics.
+        """
+        if loaded_weight.ndim == 0:
+            raise ValueError(
+                f"Full expert scale {weight_name!r} must have an expert dimension"
+            )
+        if loaded_weight.shape[0] != self.global_num_experts:
+            raise ValueError(
+                f"Full expert scale {weight_name!r} expected "
+                f"{self.global_num_experts} logical experts, got "
+                f"{loaded_weight.shape[0]}"
+            )
+        if param.shape == loaded_weight.shape:
+            param.data.copy_(loaded_weight)
+            return True
+
+        if full_scale_shard == "full_w13_scale":
+            shard_ids = ("w1", "w3")
+            if loaded_weight.ndim < 2 or loaded_weight.shape[1] % 2 != 0:
+                raise ValueError(
+                    f"Full w13 scale {weight_name!r} must have an even fused "
+                    f"projection dimension, got {tuple(loaded_weight.shape)}"
+                )
+            loaded_shards = loaded_weight.chunk(2, dim=1)
+        elif full_scale_shard == "full_w2_scale":
+            shard_ids = ("w2",)
+            loaded_shards = (loaded_weight,)
+        else:
+            raise ValueError(
+                f"Unsupported full expert scale shard: {full_scale_shard!r}"
+            )
+
+        loaded_any = False
+        for shard_id, loaded_shard in zip(shard_ids, loaded_shards):
+            for expert_id, loaded_expert in enumerate(loaded_shard.unbind(dim=0)):
+                loaded = self.weight_loader(
+                    param=param,
+                    loaded_weight=loaded_expert,
+                    weight_name=weight_name,
+                    shard_id=shard_id,
+                    expert_id=expert_id,
+                    return_success=True,
+                )
+                loaded_any = loaded_any or bool(loaded)
+        return loaded_any
+
